# ── Telegram MTProto credentials ──────────────────────────────────────────────
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
# Optional: phone number for the monitoring account (session is saved to disk)
TELEGRAM_PHONE=+000000000000

# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=changeme_use_openssl_rand_hex_32
API_ACCESS_TOKEN=changeme_set_strong_api_token
DATABASE_URL=sqlite+aiosqlite:///./tele_monitor.db

# ── Classifier ────────────────────────────────────────────────────────────────
# Path to trained sklearn model; if absent the system uses lexicon-only scoring
MODEL_PATH=../data/models/classifier.joblib

# ── Collection schedule ───────────────────────────────────────────────────────
# How often (seconds) each channel is polled for new messages
POLL_INTERVAL_SECONDS=60

# ── Alert thresholds ──────────────────────────────────────────────────────────
# Posts with score >= this are flagged HIGH
HIGH_RISK_THRESHOLD=0.75
# Posts with score >= this are flagged MEDIUM
MEDIUM_RISK_THRESHOLD=0.45

# ── CORS origin for the React frontend ───────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
